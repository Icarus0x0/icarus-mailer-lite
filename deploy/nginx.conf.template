server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __APP_PATH__/public;
    # index.html matters here, not just index.php: public/app/ (the built
    # React SPA) is a real directory, so a bare "/app" request 301s to
    # "/app/" and nginx then looks for a directory index INSIDE it before
    # ever reaching Laravel's router. Without index.html listed, nginx
    # can't find one there (there's no index.php in that directory) and
    # returns a bare 403 instead of serving the SPA.
    index index.php index.html;

    client_max_body_size 20M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php__PHP_VERSION__-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    access_log /var/log/nginx/__DOMAIN__.access.log;
    error_log /var/log/nginx/__DOMAIN__.error.log;
}
